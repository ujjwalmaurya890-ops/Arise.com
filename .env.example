# Public Firebase web app configuration (identifiers, NOT server secrets).
FIREBASE_WEB_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_WEB_APP_ID=REPLACE_WITH_FIREBASE_WEB_APP_ID

# SERVER ONLY. Set as a Netlify Functions-scoped secret. Never use a PUBLIC_ prefix.
# Copy the downloaded service-account JSON as one line, preserving its escaped \n.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-project-id","client_email":"arise-server@your-project-id.iam.gserviceaccount.com","private_key":"REPLACE_IN_SERVER_ENV_ONLY"}'

# Optional existing AI integration, server only.
ANTHROPIC_API_KEY=REPLACE_ONLY_IF_USING_AI_FEATURES
# Optional local static/API server port.
PORT=8123
