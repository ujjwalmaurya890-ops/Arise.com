{
  "name": "arise-cse-workspace",
  "version": "2.4.0",
  "private": true,
  "description": "Arise CSE — approved-account Google workspace with UID-isolated progress sync",
  "scripts": {
    "dev": "npm run build && node --env-file-if-exists=.env scripts/serve.mjs",
    "start": "node --env-file-if-exists=.env scripts/serve.mjs",
    "build:chunks": "node scripts/tools/build-widget-chunks.cjs",
    "test": "npm run build:chunks && node scripts/_run-test.cjs --all && npm run test:cloud",
    "build": "node scripts/build.mjs",
    "test:cloud": "node --test tests/cloud/*.test.cjs",
    "test:rules": "node --test tests/emulator/firestore-rules.test.cjs",
    "configure:access": "node --env-file-if-exists=.env scripts/configure-access.cjs",
    "test:browser": "node scripts/verify-secure-browser.cjs",
    "audit:storage": "node scripts/tools/audit-storage.cjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@sparticuz/chromium": "^153.0.0",
    "acorn": "^8.15.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.64.1"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18"
  },
  "engines": {
    "node": ">=22.22.0 <25"
  }
}
